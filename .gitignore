# Maven
/target/

# Frontend dependencies & build cache
frontend/node_modules/
frontend/.vite/
frontend/dist/
frontend/coverage/

# Bundled Node.js binary (not needed in repo — use system Node or frontend-maven-plugin)
frontend/node/

# Frontend public mirror of static logos (source of truth is src/main/resources/static/uk_banks_logos/)
frontend/public/

# Built frontend output (generated by mvn package — do not commit)
src/main/resources/static/assets/
src/main/resources/static/index.html

# Local Spring config (contains secrets)
src/main/resources/application-local.yml

# Env files
.env
.env.local
.env.*.local

# IDE
.idea/
*.iml

# OS
.DS_Store
